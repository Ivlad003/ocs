#!/usr/bin/env bash
# ocs — кілька opencode web на різних портах + публікація в tailnet

set -eu

ROOT="${OCS_ROOT:-$HOME/Documents}"   # де шукати проєкти
REG="$HOME/.ocs"                      # реєстр запущеного
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
DAT="${XDG_DATA_HOME:-$HOME/.local/share}"
# автономний режим — аналог `opencode --auto` (у serve такого прапорця немає):
# усе дозволено, крім явно заборонених у конфігу; вихід за теку проєкту — з питанням
AUTO_PERM='{"*":"allow","external_directory":"ask"}'
touch "$REG"

usage() {
  cat <<'TXT'
ocs — кілька opencode web на різних портах + публікація в tailnet

  ocs [тека]          запустити поточну теку (або вказану), вибрати порт
  ocs pick            вибір теки з навігацією (старт — поточна тека)
  ocs ls                що працює зараз
  ocs stop <порт|all>   зупинити інстанс
  ocs term [шрифт]      веб-термінал ttyd (типово 25, порт 7681)
  ocs expose <порт>     прокинути будь-який локальний порт у tailnet
  ocs funnel <порт>     опублікувати локальний порт в інтернет (Funnel)
  ocs off <порт>        прибрати прокинутий порт
  ocs reset             зупинити ВСЕ, зняти правила tailscale serve, очистити реєстр
  ocs help              ця довідка

Змінні оточення:
  OCS_ROOT   де шукати проєкти            (типово ~/Documents)
  OCS_AUTO   автономний режим: агент не питає дозволів (типово 1, 0 — вимкнути)

Приклад:
  OCS_ROOT=~/Documents/pet_project ocs
  ocs term               # термінал, шрифт 25
  ocs term 30            # те саме, шрифт 30
  ocs expose 8080        # Open WebUI, Olla тощо
  ocs funnel 4096        # опублікувати порт 4096 для всього інтернету
  ocs stop all
TXT
}

missing() {
  local os; os="$(uname -s)"
  echo >&2
  case "$1" in
    opencode)
      echo "opencode не знайдено в PATH." >&2; echo >&2
      echo "  встановити:  curl -fsSL https://opencode.ai/install | bash" >&2
      echo "  або:         npm i -g opencode-ai" >&2
      echo "  сайт:        https://opencode.ai" >&2 ;;
    tailscale)
      echo "tailscale не знайдено в PATH." >&2; echo >&2
      if [ "$os" = Darwin ]; then
        echo "  встановити:  brew install --cask tailscale" >&2
        echo "  далі:        tailscale up" >&2
        command -v brew >/dev/null 2>&1 || \
          echo '  немає brew:  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"' >&2
      else
        echo "  встановити:  curl -fsSL https://tailscale.com/install.sh | sh" >&2
      fi
      echo "  завантажити: https://tailscale.com/download" >&2
      echo "  сайт:        https://tailscale.com" >&2; echo >&2
      echo "  Після встановлення увімкни HTTPS:" >&2
      echo "  https://login.tailscale.com/admin/dns → Enable HTTPS" >&2 ;;
    ttyd)
      echo "ttyd не знайдено в PATH." >&2; echo >&2
      if [ "$os" = Darwin ]; then
        echo "  встановити:  brew install ttyd" >&2
        echo "  перевірити:  ttyd --version" >&2
      else
        echo "  встановити:  sudo apt install ttyd   (або збірка з джерел)" >&2
      fi
      echo "  релізи:      https://github.com/tsl0922/ttyd/releases" >&2
      echo "  доки:        https://tsl0922.github.io/ttyd/" >&2 ;;
  esac
  echo >&2
  exit 1
}

host() { tailscale status --json | sed -n 's/.*"DNSName": *"\([^"]*\)\..*/\1/p' | head -1; }
free() { ! lsof -i :"$1" >/dev/null 2>&1; }

# pid з реєстру можна вбивати лише якщо це справді наш opencode/ttyd:
# pid 0/1/порожній або перевикористаний іншим процесом — ні (kill -- -1 валить усю сесію)
ours() {
  case "${1:-}" in ''|*[!0-9]*|0|1) return 1 ;; esac
  [ "$1" != "$$" ] || return 1
  ps -o command= -p "$1" 2>/dev/null | grep -qE '(^|/)(opencode|ttyd)( |$)'
}

qr() {
  # QR-код лінка в термінал; без qrencode — підказка як встановити
  if command -v qrencode >/dev/null 2>&1; then
    qrencode -t ANSIUTF8 "$1"
  elif [ "$(uname -s)" = Darwin ]; then
    echo "  (немає qrencode — QR не покажу: brew install qrencode)"
  else
    echo "  (немає qrencode — QR не покажу: sudo apt install qrencode)"
  fi
}

pick() {
  # інтерактивний браузер підпапок: старт — поточна тека, номер — углиб, .. — угору, . або Enter — вибрати
  local top cur dirs=() i choice d
  top="$(cd "$ROOT" 2>/dev/null && pwd)" || { echo "Немає теки $ROOT (OCS_ROOT)"; exit 1; }
  cur="${PWD}"
  case "$cur" in
    "$top"|"$top"/*) : ;;                 # у межах OCS_ROOT — старт тут, межа ROOT
    "$HOME"|"$HOME"/*) top="$HOME" ;;     # поза ROOT, але вдома — межа HOME
    *) top="$cur" ;;                      # інакше старт і межа — місце запуску
  esac
  while :; do
    dirs=()
    for d in "$cur"/*/; do [ -d "$d" ] && dirs+=("${d%/}"); done
    echo >&2
    echo >&2 "Тека: $cur"
    echo >&2 "  .)  вибрати цю теку"
    [ "$cur" != "$top" ] && echo >&2 "  ..) вище"
    i=1
    for d in "${dirs[@]}"; do echo >&2 "  $i) $(basename "$d")/"; i=$((i+1)); done
    IFS= read -r -p 'Вибір: ' choice || return 1
    case "$choice" in
      ''|'.') printf '%s\n' "$cur"; return 0 ;;
      '..') [ "$cur" != "$top" ] && cur="$(dirname "$cur")" ;;
      *)
        case "$choice" in
          *[!0-9]*) : ;;
          *) if [ "$choice" -ge 1 ] 2>/dev/null && [ "$choice" -le "${#dirs[@]}" ] 2>/dev/null; then
               cur="${dirs[$((choice-1))]}"
             fi ;;
        esac
        ;;
    esac
  done
}

start() {
  local dir="" arg="${1:-}" pick_mode=0
  case "$arg" in
    pick|--pick|-p) pick_mode=1 ;;
    "" )
      # без аргументів — поточна тека, крім випадків коли ми в самому ROOT/HOME
      case "$PWD" in
        "$ROOT"|"$HOME"|"$HOME/Documents") pick_mode=1 ;;
        *) dir="$PWD" ;;
      esac
      ;;
    ~|~/*) dir="${arg/#~/$HOME}" ;;
    /*) dir="$arg" ;;
    .|./*|../*) dir="$PWD/$arg" ;;
    *)
      # спочатку як шлях від PWD, потім як ім'я теки в OCS_ROOT
      if [ -d "$PWD/$arg" ]; then dir="$PWD/$arg"
      elif [ -d "$ROOT/$arg" ]; then dir="$ROOT/$arg"
      else echo "Немає теки: $arg (ні ./$arg, ні \$OCS_ROOT/$arg)"; exit 1; fi
      ;;
  esac
  if [ -n "$dir" ]; then
    dir="$(cd "$dir" 2>/dev/null && pwd)" || { echo "Немає теки: $arg"; exit 1; }
  fi

  if [ "$pick_mode" = 1 ]; then
    dir="$(pick)"
    dir="$(cd "$dir" 2>/dev/null && pwd)" || { echo "Немає теки: $dir"; exit 1; }
  else
    echo "Тека: $dir"
  fi

  local p=4096
  while ! free "$p"; do p=$((p+1)); done
  printf 'Порт [%s]: ' "$p"; read -r x; p="${x:-$p}"
  free "$p" || { echo "Порт $p зайнятий"; exit 1; }

  # HOME=$dir тримає пікер проєктів усередині теки, XDG_* лишають конфіг на місці
  local perm="${OPENCODE_PERMISSION:-}"
  [ "${OCS_AUTO:-1}" = 0 ] || perm="$AUTO_PERM"
  ( cd "$dir" && HOME="$dir" XDG_CONFIG_HOME="$CFG" XDG_DATA_HOME="$DAT" \
      OPENCODE_PERMISSION="$perm" nohup opencode serve --hostname 127.0.0.1 --port "$p" \
      >"$dir/.ocs.log" 2>&1 & echo $! >"$REG.pid" )
  sleep 1

  # реальний pid слухача: nohup/exec можуть лишити $! не тим процесом
  local pid
  pid="$(lsof -tiTCP@127.0.0.1:"$p" 2>/dev/null | head -1 || true)"
  [ -n "$pid" ] || pid="$(cat "$REG.pid")"

  # спершу в реєстр: якщо tailscale serve впаде (set -e), процес не лишиться сиротою
  printf '%s\t%s\t%s\n' "$p" "$pid" "$dir" >>"$REG"
  rm -f "$REG.pid"
  tailscale serve --bg --https="$p" "localhost:$p" >/dev/null
  echo "→ https://$(host):$p"
  [ "${OCS_AUTO:-1}" = 0 ] || echo "  режим: автономний (OCS_AUTO=0 — з питаннями)"

  # opencode v2 генерує пароль сервера сам і пише його в лог — показуємо його
  local code i
  for i in 1 2 3 4 5; do
    code="$(sed -n 's/^server password //p' "$dir/.ocs.log" 2>/dev/null | tail -1)"
    [ -n "$code" ] && break
    sleep 1
  done
  if [ -n "$code" ]; then
    echo "  код: $code"
    # лінк з автоматичним логіном: /connect#<base64url JSON> — формат opencode pair
    local url payload
    url="https://$(host):$p"
    payload="$(printf '{"urls":["%s"],"username":"opencode","password":"%s"}' "$url" "$code" \
      | base64 | tr -d '\n' | tr '+/' '-_' | tr -d '=')"
    echo "  лінк: $url/connect#$payload"
    qr "$url/connect#$payload"
  else
    # opencode 1.x без OPENCODE_SERVER_PASSWORD пароля не генерує — QR простого лінка
    qr "https://$(host):$p"
  fi
}

term() {
  local fs="${1:-25}" p="${2:-7681}" lo=lo
  [ "$(uname -s)" = Darwin ] && lo=lo0
  command -v ttyd >/dev/null 2>&1 || missing ttyd
  while ! free "$p"; do p=$((p+1)); done

  # -i lo0: tailscale serve сам слухає цей порт на тайнет-адресі
  # без -c: Basic Auth ламає websocket-апгрейд, периметр — тайнет
  nohup ttyd -i "$lo" -p "$p" -W \
    -t fontSize="$fs" -t lineHeight=1.2 -t scrollback=5000 \
    tmux new -A -s term >"$HOME/.ocs-term.log" 2>&1 &
  local pid=$!
  sleep 1
  kill -0 "$pid" 2>/dev/null || { echo "ttyd не піднявся:"; tail -n 5 "$HOME/.ocs-term.log"; exit 1; }

  tailscale serve --bg --https="$p" "localhost:$p" >/dev/null
  printf '%s\t%s\t%s\n' "$p" "$pid" "ttyd" >>"$REG"
  local url
  url="https://$(host):$p"
  echo "→ $url  (шрифт $fs)"
  qr "$url"
}

ls_() {
  local p pid dir
  while IFS=$'\t' read -r p pid dir; do
    [ -n "${p:-}" ] || continue
    kill -0 "$pid" 2>/dev/null && echo "  $p  $(basename "$dir")  https://$(host):$p"
  done <"$REG"
  echo; tailscale serve status
}

stop() {
  local key="$1" tmp p pid dir seen=" "
  tmp=$(mktemp)
  while IFS=$'\t' read -r p pid dir; do
    [ -n "${p:-}" ] || continue
    if [ "$key" = all ] || [ "$key" = "$p" ]; then
      ours "$pid" && kill "$pid" 2>/dev/null || true
      for lp in $(lsof -tiTCP@127.0.0.1:"$p" 2>/dev/null || true); do
        ours "$lp" && kill "$lp" 2>/dev/null || true   # добити реального слухача порту
      done
      tailscale serve --yes --https="$p" off >/dev/null 2>&1 || true
      seen="$seen$p "
      echo "зупинено $p"
    else
      printf '%s\t%s\t%s\n' "$p" "$pid" "$dir" >>"$tmp"
    fi
  done <"$REG"
  mv "$tmp" "$REG"

  # сироти: інстанси ocs, що випали з реєстру (reset, старі версії, збій старту)
  local op
  for pid in $(pgrep -f 'opencode (serve|web) --hostname 127\.0\.0\.1 --port ' 2>/dev/null || true); do
    op="$(ps -o command= -p "$pid" 2>/dev/null | sed -n 's/.*--port \([0-9]*\).*/\1/p')"
    [ -n "$op" ] || continue
    [ "$key" = all ] || [ "$key" = "$op" ] || continue
    case "$seen" in *" $op "*) continue ;; esac
    ours "$pid" || continue
    kill "$pid" 2>/dev/null || true
    tailscale serve --yes --https="$op" off >/dev/null 2>&1 || true
    echo "зупинено $op (не було в реєстрі)"
  done
  echo; echo "правила tailscale зараз:"; tailscale serve status
}

off() {
  # зняти публікацію порту; якщо її немає — сказати по-людськи, а не падати.
  # CLI 1.52+: status --json кладе кожен опублікований порт у "TCP" → "<порт>":
  # (serve, funnel і expose потрапляють туди однаково), тож grep по ключу порту
  local p="$1"
  if tailscale serve status --json 2>/dev/null | grep -q "\"$p\":"; then
    tailscale serve --yes --https="$p" off >/dev/null 2>&1 || true
    echo "знято $p"
  else
    echo "порт $p не опублікований"
  fi
}

funnel() {
  # публікація локального порту в інтернет: tailscale funnel (CLI 1.52+)
  # дозволені funnel-порти — лише 443/8443/10000; зняти — ocs off <funnel-порт>
  local lp="$1" fp x caps url
  caps="$(tailscale status --json 2>/dev/null || true)"
  # без можливостей funnel/HTTPS tailscale funnel висне в інтерактивному
  # воркфлоу ввімкнення фічі — перевіряємо заздалегідь і кажемо по-людськи
  if ! printf '%s' "$caps" | grep -q '"funnel"'; then
    echo "Funnel не увімкнений для цього тайнету."; echo
    echo "  увімкнути: https://login.tailscale.com/admin/acls"
    echo '             nodeAttrs: [{target: ["*"], attr: ["funnel"]}]'
    echo "  доки:      https://tailscale.com/docs/reference/tailscale-cli/funnel"
    exit 1
  fi
  if ! printf '%s' "$caps" | grep -q '"https"'; then
    echo "HTTPS не увімкнений для тайнету:"
    echo "  https://login.tailscale.com/admin/dns → Enable HTTPS"
    exit 1
  fi
  printf 'Funnel-порт [443] (443|8443|10000): '; read -r x; fp="${x:-443}"
  case "$fp" in 443|8443|10000) : ;; *) echo "дозволені лише 443, 8443, 10000"; exit 1 ;; esac
  tailscale funnel --bg --https="$fp" "localhost:$lp" >/dev/null
  if [ "$fp" = 443 ]; then url="https://$(host)"; else url="https://$(host):$fp"; fi
  echo "→ $url  (увесь інтернет ← localhost:$lp)"
  qr "$url"
}

command -v tailscale >/dev/null 2>&1 || missing tailscale
case "${1:-start}" in
  ls|stop|expose|funnel|off|reset|term|help|-h|--help) : ;;
  *) command -v opencode >/dev/null 2>&1 || missing opencode ;;
esac

case "${1:-start}" in
  start)          start "${2:-}" ;;
  pick)           start pick ;;
  ls)             ls_ ;;
  term)           term "${2:-}" "${3:-}" ;;
  stop)           stop "${2:?потрібен порт або all}" ;;
  expose)         tailscale serve --bg --https="${2:?потрібен порт}" "localhost:${2}" >/dev/null
                  url="https://$(host):${2}"
                  echo "→ $url"
                  qr "$url" ;;
  funnel)         funnel "${2:?потрібен локальний порт}" ;;
  reset)          printf 'Зупинити ВСІ інстанси й зняти ВСІ правила tailscale serve? [y/N] '; read -r a
                  case "$a" in y|Y) stop all >/dev/null   # інакше процеси лишаться сиротами
                                    tailscale serve reset; : >"$REG"; echo "готово" ;;
                               *) echo "скасовано" ;; esac ;;
  off)            off "${2:?потрібен порт}" ;;
  help|-h|--help) usage ;;
  *) # ocs <тека>: шлях, ./шлях, ~/шлях або ім'я теки в OCS_ROOT
                  start "$1" ;;
esac
